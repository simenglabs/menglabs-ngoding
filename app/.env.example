# Drizzle — Turso
DATABASE_URL=libsql://menglabs-ngoding-menglabs.aws-ap-northeast-1.turso.io
DATABASE_AUTH_TOKEN=<turso-token>
LLM_BASE_URL=https://omni.menglabs.id/v1
LLM_API_KEY=<llm-api-key>
# Stable random secret used to encrypt user-provided LLM keys (for example: openssl rand -hex 32).
LLM_CREDENTIAL_KEY=<64-character-random-secret>
LLM_MODEL=antigravity/claude-opus-4-6-thinking
LLM_MAX_CONCURRENCY=4
# Batasi satu bagian planning agar worker sempat menyimpan status dan mencoba ulang.
LLM_REQUEST_TIMEOUT_MS=45000
# Optional break-glass admin key. Project-scoped agent tokens are created in the UI.
AGENT_API_KEY=
